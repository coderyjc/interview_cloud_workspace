# Credentials are provided by the exam platform. Do NOT commit the real .env.
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# The exam endpoint speaks the OpenAI protocol only. This project ships a
# built-in LiteLLM proxy that translates Anthropic (/v1/messages, used by
# Claude Code) <-> OpenAI (/v1/chat/completions). You only configure EXAM_*.

EXAM_BASE_URL=https://showmevibecode.up.railway.app/api/model/v1
EXAM_API_KEY=
EXAM_MODEL=linext-5.3-luna

# Internal key between Claude Code and the local LiteLLM proxy (any value).
# LITELLM_MASTER_KEY=sk-workbench

# Workbench tuning
MAX_CONCURRENT_RUNS=4
RUN_TIMEOUT_SECONDS=1800
